import discord
from discord import app_commands
from discord.ext import commands
class HelpCog(commands.Cog):
    def _init_(self, bot: commands.Bot):
        self.bot = bot

class MainsSelect(discord.ui.Select):
    def _init_(self):
        options = [
            discord.SelectOption(label="Translation", value="translation"),
            discord.SelectOption(label="Antispam", value="antispam"),
        ]

        super()._init_(
            placeholder="Choose a system...",
            min_values=1,
            max_values=1,
            options=options
        )

    async def callback(self, interaction: discord.Interaction):
        choice = self.values[0]

        view = SubView(choice)
        await interaction.response.edit_message(
            content=f"Selected: {choice}\nNow choose an option:",
            view=view
        )

        HELP_DATA = {
            "translation": {
                "config": """Type '/tr_add in any text channel on you Discord server and choose the channels
                    you want to mirror, then choose the language you want for each channel in a list.""",
                "works": """Gerentiu gets the message sent on a text channel and verifies if it's on a translation
                    pair, if it's not, he just throws it away (No messages are saved! Privacy!), if it is, then he
                    translates it using ArgosTranslate and does some Webhook magic (Uuuhh) and sends it as if it is
                    the message author, with profile picture and name! He mirrors image, emojis, gifs and other
                    stuff aswell. Fantastic!.""",
                "remove": """Type '/tr_remove' in any text channel on your Discord server, choose the text channels
                you want to remove pairing and then 'poof!', gone, reduced to atoms."""
            },
            "antispam": {
                "config": "Type '/antispam.",
                "works": "Detecta spam com base em mensagens por tempo.",
                "remove": "Use /antispam disable para desativar."
            }
        }

        text = HELP_DATA[self.category][action]

        embed = discord.Embed(
            title=f"{self.category.capitalize()} • {action.replace('_', ' ').title()}",
            description=text,
            color=discord.Color.blue()
        )

        await interaction.response.edit_message(
            embed=embed,
            view=None
        )

class SubSelect(discord.ui.Select):
    def _init_(self, category: str):
        self.category = category

        options = [
            discord.SelectOption(label="How to config", value="config")]
            discord.SelectOption(label="How it works", value="works")] #It just works... - Todd Howard 2015
            discord.SelectOption(label="How to remove", value="remove")]
        ]
        return category
